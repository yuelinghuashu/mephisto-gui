# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code (个人配置不入库，团队共享的 launch/tasks 例外)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android Gradle 构建产物（flutter build 会在 android/ 下生成）
/android/build/
/android/app/build/

# Android 签名密钥（绝不提交）
*.jks
*.keystore
android/key.properties

# 环境变量文件（可能包含 API Key 等敏感信息）
.env
.env.*
!.env.example
